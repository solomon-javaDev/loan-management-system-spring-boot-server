<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.sol.loanmanagementsystemspringbootserver.controllers.UsersController">
  <children><VBox spacing="12" padding="20">
    <Label text="User Accounts" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label text="Create field officer and staff accounts" />
    <GridPane hgap="8" vgap="8">
      <Label text="First name" /><TextField fx:id="firstName" GridPane.columnIndex="1" />
      <Label text="Last name" GridPane.rowIndex="1" /><TextField fx:id="lastName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label text="Username" GridPane.rowIndex="2" /><TextField fx:id="username" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <Label text="Password" GridPane.rowIndex="3" /><PasswordField fx:id="password" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <Label text="Email" GridPane.rowIndex="4" /><TextField fx:id="telephoneOrEmail" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label text="Role" GridPane.rowIndex="5" /><ComboBox fx:id="role" GridPane.columnIndex="1" GridPane.rowIndex="5" />
      <Button text="Create account" onAction="#createUser" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>
    <Label fx:id="messageLabel" />
  </VBox></children>
</AnchorPane>
