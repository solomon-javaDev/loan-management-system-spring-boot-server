<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" prefHeight="554.0" prefWidth="677.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.sol.loanmanagementsystemspringbootserver.controllers.FinanceController">
   <content>
      <VBox minWidth="500.0" prefHeight="634.0" prefWidth="591.0" spacing="10.0">
         <children>
            <Label text="BUSINESS FINANCE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="messageLabel" layoutX="10.0" layoutY="10.0" text="MESSAGE" />
            <TitledPane layoutX="5.0" layoutY="5.0" text="RECORD EXPENSE" textAlignment="CENTER" textOverrun="CENTER_WORD_ELLIPSIS" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane hgap="8.0" minHeight="120.0" minWidth="466.0" vgap="8.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Description" />
                        <TextField fx:id="expenseDescription" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" />
                        <Label text="Category" GridPane.rowIndex="1" />
                        <TextField fx:id="expenseAmount" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Amount" GridPane.rowIndex="2" />
                        <ComboBox fx:id="expenseCategoryDropDown" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>

               </content>
                <graphic>
                    <Button fx:id="recordExpense" mnemonicParsing="false" onMouseClicked="#recordExpense" prefHeight="25.0" prefWidth="111.0" text="SAVE EXPENSE" />
                </graphic>
               <font>
                  <Font name="Cambria Bold" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </TitledPane>
            <TitledPane layoutX="5.0" layoutY="5.0" prefHeight="178.0" prefWidth="539.0" text="CASH AT HAND" textAlignment="CENTER" textOverrun="CENTER_WORD_ELLIPSIS" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane hgap="8.0" minHeight="120.0" minWidth="466.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="Movement" />
                        <Label text="Description" GridPane.rowIndex="1" />
                        <TextField fx:id="cashAmount" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="cashDescription" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Amount" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cashType" prefHeight="29.0" prefWidth="220.0" GridPane.columnIndex="1" />
                     </children>
                  </GridPane>
               </content>
               <graphic>
                  <Button fx:id="recordCash" mnemonicParsing="false" onMouseClicked="#recordCash" prefHeight="29.0" prefWidth="163.0" text="Record Cash Movement" />
               </graphic>
               <font>
                  <Font name="Cambria Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="5.0" right="5.0" />
               </VBox.margin>
            </TitledPane>
            <TitledPane layoutX="10.0" layoutY="159.0" text="CUSTOMER SAVINGS" textAlignment="CENTER" textOverrun="CENTER_WORD_ELLIPSIS" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane hgap="8.0" minHeight="120.0" minWidth="466.0" prefHeight="154.0" prefWidth="489.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="Customer" />
                        <Label text="Movement" GridPane.rowIndex="1" />
                        <TextField fx:id="savingsAmount" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="savingsCustomerId" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Amount" GridPane.rowIndex="2" />
                        <ComboBox fx:id="savingsCustomer" prefHeight="29.0" prefWidth="219.0" GridPane.columnIndex="1" />
                        <ComboBox fx:id="savingsType" layoutX="259.0" layoutY="15.0" prefHeight="29.0" prefWidth="218.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </content>
               <graphic>
                  <Button fx:id="saveSavings" mnemonicParsing="false" onMouseClicked="#recordSavings" prefHeight="29.0" prefWidth="163.0" text="Record Savings Movement" />
               </graphic>
               <font>
                  <Font name="Cambria Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="5.0" right="5.0" />
               </VBox.margin>
            </TitledPane>
         </children>
      </VBox>
   </content>
</ScrollPane>
