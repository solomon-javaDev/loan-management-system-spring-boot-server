<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="480.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <BorderPane prefHeight="480.0" prefWidth="760.0">
         <top>
            <HBox spacing="12.0">
               <children>
                  <Label text="Cashier Dashboard" />
                  <Button text="Open Day" />
                  <Button text="Close Day" />
               </children>
               <padding>
                  <Insets top="10.0" left="10.0" right="10.0" bottom="10.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <TableView prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn text="Date" />
                <TableColumn text="Type" />
                <TableColumn text="Amount" />
                <TableColumn text="Reference" />
              </columns>
            </TableView>
         </center>
         <bottom>
            <Label text="Running balance" />
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
