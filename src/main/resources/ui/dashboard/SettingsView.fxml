<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane nodeOrientation="LEFT_TO_RIGHT" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.sol.loanmanagementsystemspringbootserver.controllers.SettingsController">
   <children>
      <ScrollPane fitToWidth="true" prefHeight="500.0" prefWidth="700.0" AnchorPane.bottomAnchor="2.0" AnchorPane.leftAnchor="2.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="20.0">
         <content>
            <VBox prefHeight="1072.0" prefWidth="685.0" spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  
                  <TitledPane animated="false" collapsible="false" text="Reporting Settings">
                     <content>
                        <GridPane hgap="10.0" vgap="15.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label text="Admin Email(s):" />
                              <TextField fx:id="adminEmailsField" promptText="email1@example.com, email2@example.com" GridPane.columnIndex="1" />
                              
                              <Label text="Enable Daily Report:" GridPane.rowIndex="1" />
                              <CheckBox fx:id="dailyReportCheckbox" mnemonicParsing="false" text="Active" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              
                              <Label text="Daily Report Time:" GridPane.rowIndex="2" />
                              <TextField fx:id="dailyTimeField" promptText="HH:mm (e.g. 08:30)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              
                              <Label text="Aging Analysis Freq:" GridPane.rowIndex="3" />
                              <ComboBox fx:id="agingFreq" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <Label text="Expense Category" GridPane.rowIndex="4" />
                              <HBox prefHeight="100.0" prefWidth="200.0" spacing="8.0" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
                                 <children>
                                    <TextField fx:id="expenseCategory" />
                                    <Button fx:id="addCategoryBtn" mnemonicParsing="false" onMouseClicked="#addCategory" text="Add Category" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                     </content>
                  </TitledPane>
                  
                  <TitledPane animated="false" collapsible="false" text="Capital &amp; Cash Management">
                     <content>
                        <GridPane hgap="10.0" vgap="15.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <Label text="Total Capital Present:" />
                              <Label fx:id="totalCapitalLabel" style="-fx-font-weight: bold;" text="0.00" GridPane.columnIndex="1" />
      
                              <Label text="Money Taken Out:" GridPane.rowIndex="1" />
                              <Label fx:id="totalCashOutLabel" style="-fx-font-weight: bold; -fx-text-fill: red;" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
                              <Label text="Record Transaction:" GridPane.rowIndex="5" />
                              <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                 <children>
                                    <TextField fx:id="transactionAmount" prefWidth="100.0" promptText="Amount" />
                                    <ComboBox fx:id="transactionType" prefWidth="160.0" promptText="Transfer type" />
                                    <Button mnemonicParsing="false" onAction="#recordBankTransaction" text="Record" />
                                 </children>
                              </HBox>
                              <Label text="Bank balance" GridPane.rowIndex="3" />
                              <Label layoutX="19.0" layoutY="95.0" text="Cash On Hand" GridPane.rowIndex="2" />
                              <Label text="Owner capital" GridPane.rowIndex="4" />
                              <TextField fx:id="cashOnHandField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              <TextField fx:id="bankBalanceField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <TextField fx:id="ownersCapitalField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                           </children>
                        </GridPane>
                     </content>
                  </TitledPane>
      
                  <TitledPane animated="false" collapsible="false" text="Loan Fee Buckets">
                     <content>
                        <VBox spacing="10.0">
                           <GridPane hgap="10.0" vgap="10.0">
                              <columnConstraints>
                                 <ColumnConstraints minWidth="150.0" />
                                 <ColumnConstraints hgrow="ALWAYS" />
                              </columnConstraints>
                              <children>
                                 <Label text="Minimum loan amount:" />
                                 <TextField fx:id="feeMinAmountField" promptText="e.g. 0" GridPane.columnIndex="1" />
                                 <Label text="Maximum loan amount:" GridPane.rowIndex="1" />
                                 <TextField fx:id="feeMaxAmountField" promptText="e.g. 100000" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                 <Label text="Fee amount:" GridPane.rowIndex="2" />
                                 <TextField fx:id="feeAmountField" promptText="e.g. 500" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              </children>
                              <rowConstraints>
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                              </rowConstraints>
                           </GridPane>
                           <HBox spacing="8.0">
                              <Button onMouseClicked="#saveFeeBucket" text="Save Fee Bucket" />
                              <Button onMouseClicked="#updateFeeBucket" text="Update" />
                               <Button onMouseClicked="#deleteFeeBucket" text="Delete" />
                               <Button onMouseClicked="#clearFeeBucketFields" text="Clear" />

                           </HBox>
                           <TableView fx:id="feeBucketsTable" onMouseClicked="#selectFeeBucket" prefHeight="120.0">
                              <columns>
                                 <TableColumn fx:id="feeMinColumn" prefWidth="150.0" text="Minimum" />
                                 <TableColumn fx:id="feeMaxColumn" prefWidth="150.0" text="Maximum" />
                                 <TableColumn fx:id="feeAmountColumn" prefWidth="150.0" text="Fee" />
                              </columns>
                           </TableView>
                        </VBox>
                     </content>
                  </TitledPane>
      
                   <HBox alignment="CENTER_RIGHT" spacing="10.0">
                      <children>
                         <Label fx:id="messageLabel" text="" />
                         <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="30.0" prefWidth="120.0" style="-fx-base: #2196F3; -fx-text-fill: white;" text="Save Changes" />
                      </children>
                   </HBox>
               </children>
            </VBox>
         </content>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="10.0" />
         </padding>
      </ScrollPane>
      <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="System Settings" />
   </children>
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
</AnchorPane>
