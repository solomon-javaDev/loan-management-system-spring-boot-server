<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.sol.loanmanagementsystemspringbootserver.controllers.SettingsController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="System Settings" />
            
            <TitledPane animated="false" collapsible="false" text="Reporting Settings">
               <content>
                  <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Admin Email(s):" />
                        <TextField fx:id="adminEmailsField" promptText="email1@example.com, email2@example.com" GridPane.columnIndex="1" />
                        
                        <Label text="Enable Daily Report:" GridPane.rowIndex="1" />
                        <CheckBox fx:id="dailyReportCheckbox" mnemonicParsing="false" text="Active" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Daily Report Time:" GridPane.rowIndex="2" />
                        <TextField fx:id="dailyTimeField" promptText="HH:mm (e.g. 08:30)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Aging Analysis Freq:" GridPane.rowIndex="3" />
                        <ComboBox fx:id="agingFreq" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Expense Category" GridPane.rowIndex="4" />
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="8.0" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
                           <children>
                              <TextField fx:id="expenseCategory" />
                              <Button fx:id="addCategoryBtn" mnemonicParsing="false" onMouseMoved="#addCategory" text="Add Category" />
                           </children>
                        </HBox>
                     </children>
                  </GridPane>
               </content>
            </TitledPane>
            
            <TitledPane animated="false" collapsible="false" text="Capital &amp; Cash Management">
               <content>
                  <GridPane hgap="10.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label text="Total Capital Present:" />
                        <Label fx:id="totalCapitalLabel" style="-fx-font-weight: bold;" text="0.00" GridPane.columnIndex="1" />

                        <Label text="Money Taken Out:" GridPane.rowIndex="1" />
                        <Label fx:id="totalCashOutLabel" style="-fx-font-weight: bold; -fx-text-fill: red;" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Record Transaction:" GridPane.rowIndex="5" />
                        <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                           <children>
                              <TextField fx:id="transactionAmount" prefWidth="100.0" promptText="Amount" />
                              <ComboBox fx:id="transactionType" prefWidth="120.0" />
                              <Button mnemonicParsing="false" text="Record" />
                           </children>
                        </HBox>
                        <Label text="Bank balance" GridPane.rowIndex="3" />
                        <Label layoutX="19.0" layoutY="95.0" text="Cash On Hand" GridPane.rowIndex="2" />
                        <Label text="Liquidity (capital)" GridPane.rowIndex="4" />
                        <TextField fx:id="cashOnHandField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="bankBalanceField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <TextField fx:id="ownersCapitalField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </content>
            </TitledPane>

             <TitledPane animated="false" collapsible="false" text="Loan Surcharge Policy">
                <content>
                   <GridPane hgap="10.0" vgap="15.0">
                      <columnConstraints>
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                      </columnConstraints>
                      <rowConstraints>
                         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      </rowConstraints>
                      <children>
                         <Label text="Daily surcharge beyond maturity (%):" />
                         <TextField fx:id="surchargeRateField" promptText="e.g. 2 for 2% per day" GridPane.columnIndex="1" />
                      </children>
                   </GridPane>
                </content>
             </TitledPane>

             <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <children>
                   <Label fx:id="messageLabel" text="" />
                   <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="30.0" prefWidth="120.0" style="-fx-base: #2196F3; -fx-text-fill: white;" text="Save Changes" />
                </children>
             </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
